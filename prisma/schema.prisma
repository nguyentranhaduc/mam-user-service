generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated-prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
